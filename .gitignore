# ---------------------------------------------------------------------------
# TTS workers (tts/*/setup.bat) — venvs, binaries, models, user audio
# ---------------------------------------------------------------------------

# All worker virtualenvs
tts/**/.venv/

# Piper — binary + voice models (download via setup.bat / Hugging Face)
tts/piper/piper/
tts/piper/_piper/
tts/piper/_extract/
tts/piper/*.onnx
tts/piper/*.onnx.json
tts/piper/*.dll
tts/piper/piper.exe

# Kokoro — large model weights (keep models/README.md)
tts/kokoro/models/*.onnx
tts/kokoro/models/*.bin

# XTTS — reference speaker clips
tts/xtts/speakers/*.wav
tts/xtts/xtts_speakers/*.wav

# Whisper — faster-whisper model cache (if stored locally)
tts/whisper/models/

# Bergamot — optional local model copies
tts/bergamot/models/

# StyleTTS2 — cloned upstream + weights
tts/styletts2/StyleTTS2/
tts/styletts2/models/
tts/styletts2/*.pth
